# Runtime
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/northbridgeai
SECRET_KEY=replace-with-a-long-random-value
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
REDIS_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# AI
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_PRO=
STRIPE_PRICE_INDIVIDUAL_PREMIUM=

# Private document storage
# Use "local" only for development. Production startup requires "s3".
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_REGION=ca-central-1
# Optional for S3-compatible providers. Leave empty for AWS S3.
DOCUMENT_STORAGE_ENDPOINT_URL=
